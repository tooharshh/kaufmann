# Cerebras GPT OSS 120B is selected for voice. Keep accounts on their free tiers.
CEREBRAS_API_KEY=

# Sarvam speech recognition and synthesis.
SARVAM_API_KEY=

# LiveKit Cloud project credentials.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Supabase: use the Session pooler connection string for DATABASE_URL.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

APP_ORIGIN=http://localhost:8080
API_HOST=0.0.0.0
PORT=8080

# Same independent random secret on the API and hosted voice worker.
VOICE_DISPATCH_SECRET=

# Optional isolated LiveKit deployment for local voice testing.
LIVEKIT_AGENT_DEPLOYMENT=

# Optional Gemini semantic retrieval. Apply the semantic-search migration and
# index products before enabling on both the API and voice worker.
GEMINI_API_KEY=
SEMANTIC_SEARCH_ENABLED=false
